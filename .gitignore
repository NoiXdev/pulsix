bin/
web/node_modules/
web/dist/
web/coverage/
web/test-results/
web/playwright-report/
web/.tmp/
.env
.idea/
.vscode/

# internal/web/dist holds the *committed placeholder* index.html (and
# robots.txt) that let `go build`/`go test` work without a frontend build
# (see internal/web/dist/index.html's own comment) — everything else here
# is `make web-build`'s real output (web/dist copied in before `go build`
# embeds it) and must never be committed alongside it.
internal/web/dist/*
!internal/web/dist/index.html
!internal/web/dist/robots.txt

# `scripts/agent-binaries.sh` (make agent-binaries) cross-compiles the
# agent binaries the manager embeds and serves at GET /agents/bin/... .
# They are build output, never committed; the committed .placeholder is
# what keeps `go:embed all:dist` compilable in a tree that never ran the
# script (see internal/agentdist/dist/.placeholder).
internal/agentdist/dist/*
!internal/agentdist/dist/.placeholder

# Superpowers scratch: brainstorming mockups and SDD ledgers. Local
# working state for one session, never part of the repository.
.superpowers/
