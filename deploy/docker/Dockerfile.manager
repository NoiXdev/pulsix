# Dockerfile.manager builds the Pulsix manager image: a Go binary with the
# React SPA embedded via internal/web/embed.go's `//go:embed all:dist`.
#
# Build context must be the repository root (see Makefile's `build`/
# `web-build` targets and web/e2e/global-setup.ts for the same build order
# used outside Docker):
#
#   docker build -f deploy/docker/Dockerfile.manager -t noixdev/pulsix-manager:dev .
#
# This is deliberately self-contained: it builds the SPA from web/ and the
# binary from the Go module inside the image itself, so the result does not
# depend on a previously built web/dist, a previously embedded
# internal/web/dist, or anything else already sitting in a developer's
# working tree — a clean `git clone` and this one command are enough.
#
# Base image versions were the newest stable tag on their registry as of
# 2026-09-11 (see task-16-report.md for how each was checked) and are
# pinned by tag *and* digest so a build today and a build next year from
# the same Dockerfile produce bit-identical base layers:
#   - node:24.21.0-alpine   (matches the "24" major the rest of the repo
#     already targets — web/package.json's @types/node is 24.x, and CI's
#     setup-node uses node-version 24)
#   - golang:1.27.1-alpine  (matches go.mod's `go 1.27` and this machine's
#     installed `go version` exactly)
#   - python:3.13-slim (the final, shipped stage — see below for why this
#     replaced gcr.io/distroless/static:nonroot in Task 17)
#
# Task 17 deviation from the plan's literal file list (which named only
# deploy/worker/Dockerfile and deploy/compose/docker-compose.yml): the
# compose single-node story runs an embedded worker inside this very
# container (PULSIX_EMBEDDED_WORKER=1, internal/app's embedded_worker.go).
# That embedded worker is the same worker package cmd/worker drives — for
# job kinds run/adhoc/bootstrap/rotate_key/sync_repo it shells out to
# ansible-runner/ansible-playbook/git exactly like a standalone worker
# does (connection_test alone is pure Go and needs none of this). A
# distroless/static image has no shell, no package manager and no Python
# runtime at all, so PULSIX_EMBEDDED_WORKER would silently work for
# connection tests and infrastructure-fail every other job kind — "zero
# extra services" would be a half-truth. This stage therefore carries the
# exact same Ansible runtime as deploy/worker/Dockerfile (same base image,
# same git/openssh-client/sshpass/ansible-core/ansible-runner pins), so
# the one manager image is correct whether or not an operator ever turns
# the embedded worker on. The trade-off — a heavier, non-distroless final
# image for every deployment, including ones that only ever talk to
# external workers — was accepted deliberately rather than shipping two
# manager image variants; revisit if that trade stops being worth it.

# ---- Stage 1: build the SPA ----------------------------------------------
FROM node:24.21.0-alpine@sha256:be80f76cf40ec8e42b9bec49f60a55e0660f30af58d3e5a25530785b30ea67e2 AS web
WORKDIR /src/web
# Copied separately from the rest of web/ so `npm ci` only reruns (and its
# layer only invalidates) when the lockfile actually changes.
COPY web/package*.json ./
RUN npm ci
COPY web/ ./
RUN npm run build

# ---- Stage 2: build the Go binary, embedding the SPA from stage 1 --------
FROM golang:1.27.1-alpine@sha256:cf6fca6641884b8433441b2b0652976f975e1d0fdd26d177eaaf8596087f3125 AS build
WORKDIR /src
# go.mod/go.sum first, same reasoning as npm ci above: `go mod download`
# only reruns when dependencies actually change, not on every source edit.
COPY go.mod go.sum ./
RUN go mod download
COPY . .
# internal/web/dist is tracked with a committed placeholder index.html/
# robots.txt (see that directory's own comment) so `go build`/`go test`
# work without a frontend build at all — it must be removed, not merged
# into, before the real build lands there, or a stale placeholder file
# with no counterpart in the real Vite output (robots.txt: the SPA has no
# web/public/robots.txt, so the real build never produces one) would ship
# inside the image. This mirrors web/e2e/global-setup.ts's
# rmSync(distDir)+cpSync(...) exactly.
RUN rm -rf internal/web/dist
COPY --from=web /src/web/dist ./internal/web/dist
ARG VERSION=dev
# CGO_ENABLED=0 for a fully static binary the distroless "static" base can
# run with no libc. -trimpath removes this build's absolute source paths
# from the binary; -s -w strip the symbol table and DWARF debug info both
# already unneeded at runtime. -X main.version stamps the release version
# in (see cmd/manager/main.go's `version` variable) so it can be read back
# off GET /healthz without inspecting the image tag.
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w -X main.version=${VERSION}" -o /out/pulsix-manager ./cmd/manager

# ---- Stage 3: the image that actually ships -------------------------------
# python:3.13-slim@sha256:9d2e5553305c7c7b0097999bb17187c69b921ccd6bc9d40e4bb5ebe652c00285
# — the exact same base and digest as deploy/worker/Dockerfile's own final
# stage, verified 2026-09-15 against PyPI (ansible-core 2.21.4,
# ansible-runner 2.4.3 — see that Dockerfile's own comment for why these
# exact versions and why the ansible-runner CLI needs its own pinned
# runtime rather than a prebuilt ansible-runner image).
FROM python:3.13-slim@sha256:9d2e5553305c7c7b0097999bb17187c69b921ccd6bc9d40e4bb5ebe652c00285

# git + openssh-client: the embedded worker's own repo-sync duty when
# PULSIX_EMBEDDED_WORKER=1; sshpass: one-time-password bootstrap;
# ca-certificates: https remotes and outgoing SMTP/webhooks.
RUN apt-get update \
	&& apt-get install -y --no-install-recommends git openssh-client sshpass ca-certificates \
	&& rm -rf /var/lib/apt/lists/*
RUN pip install --no-cache-dir "ansible-core==2.21.4" "ansible-runner==2.4.3"

COPY --from=build /out/pulsix-manager /pulsix-manager

# The embedded worker's scratch root when PULSIX_EMBEDDED_WORKER=1 (same
# default and layout as deploy/worker/Dockerfile's own
# PULSIX_WORKER_DATA_DIR) — created here so it exists and is writable
# under the non-root user regardless of whether the embedded worker is
# ever turned on.
RUN mkdir -p /var/lib/pulsix-worker && chmod 0700 /var/lib/pulsix-worker \
	&& chown -R 65532:65532 /var/lib/pulsix-worker
ENV PULSIX_WORKER_DATA_DIR=/var/lib/pulsix-worker
VOLUME ["/var/lib/pulsix-worker"]

EXPOSE 8080
EXPOSE 8444
# uid 65532 — the same non-root uid distroless/static:nonroot used, so
# host bind mounts or volumes created under the old image keep working.
USER 65532:65532
ENTRYPOINT ["/pulsix-manager"]
