# Dockerfile.manager builds the Pulsix manager image: a Go binary with the
# React SPA embedded via internal/web/embed.go's `//go:embed all:dist`.
#
# Build context must be the repository root (see Makefile's `build`/
# `web-build` targets and web/e2e/global-setup.ts for the same build order
# used outside Docker):
#
#   docker build -f deploy/docker/Dockerfile.manager -t noixdev/pulsix-manager:dev .
#
# This is deliberately self-contained: it builds the SPA from web/ and the
# binary from the Go module inside the image itself, so the result does not
# depend on a previously built web/dist, a previously embedded
# internal/web/dist, or anything else already sitting in a developer's
# working tree — a clean `git clone` and this one command are enough.
#
# Base image versions were the newest stable tag on their registry as of
# 2026-09-11 (see task-16-report.md for how each was checked) and are
# pinned by tag *and* digest so a build today and a build next year from
# the same Dockerfile produce bit-identical base layers:
#   - node:24.21.0-alpine   (matches the "24" major the rest of the repo
#     already targets — web/package.json's @types/node is 24.x, and CI's
#     setup-node uses node-version 24)
#   - golang:1.27.3-alpine  (matches go.mod's `go 1.27` and CI's setup-go
#     exactly; moved off 1.27.1 with backlog 1.36)
#   - gcr.io/distroless/static:nonroot (the final, shipped stage)
#
# The shipped image deliberately carries no Ansible runtime, no shell and
# no package manager. Playbooks run in the separate worker image
# (deploy/worker/Dockerfile), never next to the manager's master key and
# database credentials. The opt-in embedded worker (PULSIX_EMBEDDED_WORKER,
# for trusted single-tenant setups only) can therefore run connection
# tests only in this image — every other job kind needs the worker image's
# Ansible runtime. (Task 17 had briefly moved this stage onto the worker's
# python/Ansible base; fix round 1 reverted that as part of making a
# separate worker container the default.)

# ---- Stage 1: build the SPA ----------------------------------------------
FROM node:26.13.0-alpine@sha256:8996bb5821d62a8fd9bb27c1cb07462f3fdce6e47d640c6a881ead0b064ce216 AS web
WORKDIR /src/web
# Copied separately from the rest of web/ so `npm ci` only reruns (and its
# layer only invalidates) when the lockfile actually changes.
COPY web/package*.json ./
RUN npm ci
COPY web/ ./
RUN npm run build

# ---- Stage 2: build the Go binary, embedding the SPA from stage 1 --------
FROM golang:1.27.3-alpine@sha256:fa3d596898d9f126af7c01d14ee7597bab3f39cccf392ef36b69fe77cd681f18 AS build
WORKDIR /src
# go.mod/go.sum first, same reasoning as npm ci above: `go mod download`
# only reruns when dependencies actually change, not on every source edit.
COPY go.mod go.sum ./
RUN go mod download
COPY . .
# internal/web/dist is tracked with a committed placeholder index.html/
# robots.txt (see that directory's own comment) so `go build`/`go test`
# work without a frontend build at all — it must be removed, not merged
# into, before the real build lands there, or a stale placeholder file
# with no counterpart in the real Vite output (robots.txt: the SPA has no
# web/public/robots.txt, so the real build never produces one) would ship
# inside the image. This mirrors web/e2e/global-setup.ts's
# rmSync(distDir)+cpSync(...) exactly.
RUN rm -rf internal/web/dist
COPY --from=web /src/web/dist ./internal/web/dist
ARG VERSION=dev
# The agent binaries the manager embeds and serves at GET /agents/bin/...
# (internal/agentdist): cross-compiled here, into the same dist directory
# `make agent-binaries` fills outside Docker, BEFORE the manager build
# below embeds it — a manager built without this step serves 503 there
# and a host could not install an agent from this image. The script is
# POSIX sh on purpose: this base has busybox ash, no bash.
RUN sh scripts/agent-binaries.sh "${VERSION}"
# CGO_ENABLED=0 for a fully static binary the distroless "static" base can
# run with no libc. -trimpath removes this build's absolute source paths
# from the binary; -s -w strip the symbol table and DWARF debug info both
# already unneeded at runtime. -X main.version stamps the release version
# in (see cmd/manager/main.go's `version` variable) so it can be read back
# off GET /healthz without inspecting the image tag.
RUN CGO_ENABLED=0 go build -trimpath -ldflags="-s -w -X main.version=${VERSION}" -o /out/pulsix-manager ./cmd/manager
# An empty directory for the compose enrollment service's bundle volume
# (see the final stage): distroless has no shell to mkdir/chown there.
RUN mkdir -p /out/worker-bundle
# The embedded worker's scratch root (internal/worker.defaultDataDir). It
# has to exist, owned by the runtime user, for the same reason
# worker-bundle does: this base has no shell, so the process cannot
# mkdir it at /var/lib itself, and PULSIX_EMBEDDED_WORKER=1 otherwise
# dies on its first tick with "create repo cache dir: permission denied"
# — the GUI keeps working, so the failure is quiet and only connection
# tests and jobs are missing.
RUN mkdir -p /out/worker-data
# The backup folder (internal/backup.DefaultDir), for the compose stack's
# pulsix-backups volume: the same reason again — a fresh named volume
# inherits this ownership, so backups and `restore` can use it as nonroot.
RUN mkdir -p /out/backups

# ---- Stage 3: the image that actually ships -------------------------------
FROM gcr.io/distroless/static:nonroot@sha256:25ac8f0c3b2334a9eb05452266bd4697864a8c8ef0ef71e5e6480d7f92868329
COPY --from=build /out/pulsix-manager /pulsix-manager
# The directory `worker add --bundle-dir` writes into when the compose
# stack's enrollment service runs this image, owned by the runtime user: a
# fresh named volume mounted here inherits this ownership, so the non-root
# enrollment can write the bundle and the worker container (same uid) can
# read it. No VOLUME instruction — compose mounts a named volume, and an
# image-declared volume would leave an anonymous one behind on every
# `docker compose run`.
COPY --from=build --chown=65532:65532 /out/worker-bundle /var/lib/pulsix/worker-bundle
COPY --from=build --chown=65532:65532 /out/worker-data /var/lib/pulsix-worker
COPY --from=build --chown=65532:65532 /out/backups /var/lib/pulsix/backups
EXPOSE 8080
EXPOSE 8444
# distroless/static:nonroot's built-in "nonroot" user (uid 65532) — no
# useradd/shell available in this base to create a different one, and none
# is needed.
USER nonroot
ENTRYPOINT ["/pulsix-manager"]
