# Copy this file to .env in the same directory before running
# `docker compose up -d`:
#
#   cp .env.example .env
#
# docker-compose.yml refuses to start any service that reads a variable
# left unset or empty here (Compose's ${VAR:?message} interpolation) — so
# there is no risk of accidentally running with a blank secret, only of
# the stack refusing to start until you fill one in.

# --- Required ---------------------------------------------------------

# Password for the "pulsix" PostgreSQL role the bundled `db` service
# creates. docker-compose.yml builds PULSIX_DATABASE_URL from this itself
# (postgres://pulsix:<DB_PASSWORD>@db:5432/pulsix) — you do not set
# PULSIX_DATABASE_URL directly when using the bundled database.
#
# The "pulsix" role this password belongs to owns the schema (it ran the
# migrations that created and granted the pulsix_app role — migration
# 00002_rls.sql) and is therefore Postgres-superuser-equivalent for this
# database: on its own, that would bypass row-level security entirely. It
# is safe here ONLY because the manager never serves a request through
# this connection directly — it uses it once to run migrations, then
# reopens the database as the least-privilege pulsix_app role via SET
# ROLE, and refuses to start at all if that role could still bypass RLS
# (see internal/app/app.go's assertCannotBypassRLS). If you point the
# manager at a database you manage yourself instead of the bundled `db`
# service, the same rule applies: a superuser or schema-owner connection
# string is fine, precisely because the manager drops into pulsix_app
# itself — never point it at a role with no migration/DDL rights at all,
# or migrations will fail on first start.
#
# Generate one with:
#   openssl rand -hex 32
DB_PASSWORD=

# The instance's master key, used to encrypt secrets at rest (SMTP
# credentials, TOTP secrets, ...). Must be exactly 64 hex characters (32
# bytes). Generate one with:
#   openssl rand -hex 32
# Losing this key makes every secret it sealed permanently unrecoverable —
# back it up somewhere other than this .env file.
PULSIX_MASTER_KEY=

# The externally reachable URL this instance is served at, e.g.
# https://pulsix.example.com. Used to derive the WebAuthn relying party ID
# and origin (passkeys will not work if this does not match what the
# browser actually sees) and to build links in outgoing e-mail.
PULSIX_PUBLIC_URL=

# --- Optional ----------------------------------------------------------

# Domain the public status page is served from, if you use one. Leave
# unset to disable it.
PULSIX_STATUS_DOMAIN=

# Image tag to run. Defaults to "latest" (the most recent tagged release)
# when unset — pin it to a specific release, e.g. v0.1.0, for anything
# other than local experimentation.
PULSIX_VERSION=latest

# Host-side port the manager is published on. Defaults to 8080; override
# this (not PULSIX_LISTEN, which stays the container's internal port) if
# something else on the host already uses 8080.
PULSIX_HOST_PORT=8080

# --- Optional: workers ------------------------------------------------

# The manager's worker endpoint, inside the container. Defaults to ":8444"
# (every interface); the `worker` service reaches it over the compose
# network as "manager:8444". It is not published on the host — see
# README.md, "Workers on other machines", if you need that. You should not
# need to change this.
PULSIX_GRPC_LISTEN=:8444

# The name every worker must present as its PULSIX_MANAGER_SERVER_NAME:
# PULSIX_GRPC_LISTEN above binds every interface and therefore names no
# host of its own, so the endpoint's certificate uses this fixed name
# instead. Change it only if you also change every worker's
# PULSIX_MANAGER_SERVER_NAME to match.
PULSIX_GRPC_SERVER_NAME=pulsix-manager

# The zone the bundled `worker` service is enrolled for (a zone slug;
# "default" is the zone every organization gets), the organization slug
# (only needed when several organizations use that zone slug) and the
# worker's name. Enrollment happens automatically once the zone exists.
PULSIX_WORKER_ZONE=default
PULSIX_WORKER_ORG=
PULSIX_WORKER_NAME=worker-1

# Workers on other machines enroll with a one-time token from the Workers
# page (valid 1 hour) instead of a copied certificate bundle; the
# bundled worker service above keeps using worker-enroll.
# PULSIX_ENROLL_TOKEN=

# Runs a worker inside the manager container instead. Off by default and
# ONLY for trusted single-tenant setups: playbooks would then run next to
# PULSIX_MASTER_KEY and the database credentials, and the manager image
# has no Ansible runtime, so only connection tests work there. Leave it at
# 0 and use the `worker` service.
PULSIX_EMBEDDED_WORKER=0

# --- Optional: reverse proxy and network --------------------------------

# The reverse proxies whose X-Forwarded-For header the manager believes:
# CIDRs or single addresses, comma separated. Left unset, it trusts only
# the bundled Traefik (PULSIX_PROXY_ADDR below), which is right for a
# plain `docker compose up` and for `--profile proxy`. If your own reverse
# proxy or load balancer sits in front of the manager, set this to that
# proxy's address as the manager sees it. Without it every caller looks
# like the proxy: webhook IP allowlists never match, every audit entry
# records the proxy's address, and all webhook callers share one
# per-address budget. Never list a range that untrusted clients can
# connect from — whoever is trusted can claim any client address.
# PULSIX_TRUSTED_PROXIES=

# The stack's network (a fixed subnet, so the bundled Traefik has a fixed
# address). Containers get addresses from PULSIX_NETWORK_RANGE, and
# PULSIX_PROXY_ADDR must lie inside the subnet but outside that range.
# Change all three together, and only if the subnet collides with a
# network you already use.
# PULSIX_NETWORK_SUBNET=10.213.73.0/24
# PULSIX_NETWORK_RANGE=10.213.73.0/25
# PULSIX_PROXY_ADDR=10.213.73.254

# Playbooks run under the worker image's second, unprivileged account
# (uid 65533) rather than the worker's own, so a task aimed at the worker
# itself cannot read its client certificate and key. docker-compose.yml
# turns this on for a new installation; this is the documented way to turn
# it back off. Set it EMPTY — not to a number — and playbooks run as the
# worker, as they did before v0.4. The uid only exists inside the Pulsix
# worker image, so a derived image or a worker running outside Compose has
# to leave it empty or ship the same account and setuid helper.
#
# Known limitation either way (backlog 2.107): cancelling a run stops
# Pulsix from following it, but does not stop the playbook itself.
# PULSIX_WORKER_PLAY_UID=

# --- Optional: only used with `docker compose --profile proxy up -d` ---

# The public hostname Traefik should route to the manager, e.g.
# pulsix.example.com. Defaults to pulsix.localhost, which is only useful
# for local testing of the proxy profile itself.
PULSIX_DOMAIN=

# Contact e-mail Let's Encrypt associates with certificates Traefik
# requests. Required for the proxy profile to obtain a working TLS
# certificate; leaving it unset does not stop the stack from starting
# (see docker-compose.yml's own comment on this), but Traefik will fail
# to get a certificate until it is set.
TRAEFIK_ACME_EMAIL=
