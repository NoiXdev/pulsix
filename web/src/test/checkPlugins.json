      "name": "script",
      "runs": "agent",
      "params": [
        {
          "name": "commands",
          "type": "list",
          "required": true,
          "max_entries": 32,
          "non_empty": true,
          "format": "commandName"
        },
        {
          "name": "args",
          "type": "list",
          "example": "tcp_port:port=8080",
          "max_entries": 64,
          "max_bytes": 640,
          "format": "scriptArg"
        },
        {
          "name": "format",
          "type": "enum",
          "default": "nagios",
          "options": [
            "nagios",
            "json"
