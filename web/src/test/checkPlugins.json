    {
      "name": "docker",
      "runs": "agent",
      "params": [
        {
          "name": "selection",
          "type": "enum",
          "default": "all",
          "options": [
            "all",
            "labeled"
          ]
        },
        {
          "name": "label",
          "type": "string",
          "default": "pulsix.monitor=true",
          "format": "dockerLabel"
        },
        {
          "name": "socket",
          "type": "string",
          "default": "/var/run/docker.sock",
          "max_bytes": 255,
          "format": "dockerSocket"
        },
        {
          "name": "resources",
          "type": "bool",
          "default": false
        }
      ],
      "metrics": [
        {
          "name": "docker.state",
          "kind": "discrete"
        },
        {
          "name": "docker.health",
          "kind": "discrete"
        },
        {
          "name": "docker.restart_count",
          "kind": "numeric"
        },
        {
          "name": "docker.exit_code",
          "kind": "numeric"
        },
        {
          "name": "docker.containers_running",
          "kind": "numeric"
        },
        {
          "name": "docker.containers_total",
          "kind": "numeric"
        },
        {
          "name": "docker.containers_unreported",
          "kind": "numeric"
        },
        {
          "name": "docker.cpu_percent",
          "kind": "numeric"
        },
        {
          "name": "docker.memory_bytes",
          "kind": "numeric"
        },
        {
          "name": "docker.memory_percent",
          "kind": "numeric"
        },
        {
          "name": "docker.net_rx_bytes_per_s",
          "kind": "numeric"
        },
        {
          "name": "docker.net_tx_bytes_per_s",
          "kind": "numeric"
        },
        {
          "name": "docker.block_read_bytes_per_s",
          "kind": "numeric"
        },
        {
          "name": "docker.block_write_bytes_per_s",
          "kind": "numeric"
        },
        {
          "name": "docker.containers_unsampled",
          "kind": "numeric"
        }
      ]
    },
